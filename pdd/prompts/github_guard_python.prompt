{
  "type": "module",
  "module": {
    "exceptions": [
      {"name": "GitHubAccessDisabled", "base": "RuntimeError"}
    ],
    "functions": [
      {"name": "local_only_enabled", "signature": "() -> bool", "returns": "bool"},
      {"name": "github_auth_opted_in", "signature": "() -> bool", "returns": "bool"},
